### 2.2 Spam Reports Table (`public.spam_reports`)
Logs crowdsourced spam reports, category tags, and user IDs.

```sql
CREATE TABLE public.spam_reports (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    phone_number VARCHAR(20) NOT NULL,
    reporter_user_id UUID NOT NULL,
    category VARCHAR(50) NOT NULL, -- 'telemarketer', 'scam', 'robocall', 'debt_collector', 'survey', 'other'
    comment TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT chk_spam_phone_e164 CHECK (phone_number ~ '^\+[1-9]\d{6,14}$'),
    CONSTRAINT chk_spam_category CHECK (category IN ('telemarketer', 'scam', 'robocall', 'debt_collector', 'survey', 'other'))
);

CREATE INDEX idx_spam_reports_phone ON public.spam_reports USING btree (phone_number);
CREATE INDEX idx_spam_reports_phone_time ON public.spam_reports (phone_number, created_at DESC);
```

