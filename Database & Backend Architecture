### 2.4 High-Performance Lookup Stored Procedure (`lookup_caller`)
Combines caller name resolution, spam score calculation, and category breakdown into a **single database roundtrip** (< 10ms execution time).

```sql
CREATE OR REPLACE FUNCTION public.lookup_caller(p_phone_number VARCHAR(20))
RETURNS JSONB
LANGUAGE plpgsql STABLE SECURITY DEFINER AS $$
DECLARE
    v_primary_name VARCHAR(255);
    v_total_submissions BIGINT;
    v_total_reports BIGINT;
    v_unique_reporters BIGINT;
    v_category_counts JSONB;
    v_spam_score INT := 0;
    v_risk_level VARCHAR(25);
BEGIN
    -- Query top name from indexed view
    SELECT primary_name, total_submissions INTO v_primary_name, v_total_submissions
    FROM public.crowdsourced_names WHERE phone_number = p_phone_number;

    -- Query spam report aggregations
    SELECT COUNT(*), COUNT(DISTINCT reporter_user_id),
           COALESCE(jsonb_object_agg(cat, count_val) FILTER (WHERE cat IS NOT NULL), '{}'::jsonb)
    INTO v_total_reports, v_unique_reporters, v_category_counts
    FROM (
        SELECT category AS cat, COUNT(*) AS count_val
        FROM public.spam_reports WHERE phone_number = p_phone_number
        GROUP BY category
    ) sub;

    -- Calculate Spam Score (0 - 100)
    IF v_total_reports > 0 THEN
        v_spam_score := LEAST(100, (
            (v_unique_reporters * 15) + (v_total_reports * 5) + 
            (CASE WHEN v_category_counts ? 'scam' THEN 25 ELSE 0 END) +
            (CASE WHEN v_category_counts ? 'robocall' THEN 15 ELSE 0 END)
        )::INT);
    END IF;

    -- Risk Level Mapping
    IF v_spam_score = 0 THEN v_risk_level := 'SAFE';
    ELSIF v_spam_score < 30 THEN v_risk_level := 'LOW_RISK';
    ELSIF v_spam_score < 65 THEN v_risk_level := 'SUSPECTED_SPAM';
    ELSE v_risk_level := 'HIGH_RISK_SPAM';
    END IF;

    RETURN jsonb_build_object(
        'phone_number', p_phone_number,
        'name', COALESCE(v_primary_name, 'Unknown Caller'),
        'spam_score', v_spam_score,
        'risk_level', v_risk_level,
        'total_reports', v_total_reports,
        'total_submissions', COALESCE(v_total_submissions, 0),
        'categories', v_category_counts
    );
END;
$$;
```

